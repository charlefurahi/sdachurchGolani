# GolaniSDA Environment Variables
# Copy this file to .env and fill in your values

# API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# App Name
VITE_APP_NAME=GolaniSDA

# Church Name
VITE_CHURCH_NAME="Golani Seventh-day Adventist Church"

# Google Maps API Key (for contact page map)
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# YouTube API Key (for sermon videos)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Stripe Public Key (for donations)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# PayPal Client ID
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Email Service Key (newsletter)
VITE_EMAIL_SERVICE_KEY=your_email_service_key_here

# Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Flags
VITE_ENABLE_LIVE_STREAM=true
VITE_ENABLE_DONATIONS=true
VITE_ENABLE_AUTH=true
